# Binários e executáveis Go
bin/
dist/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Bancos de dados SQLite locais
*.db
*.db-journal
*.db-wal
*.db-shm
.memory/*.db
.memory/*.db-*

# Dados de teste e vaults locais
data/
vault_test/

# Arquivos de ambiente e segredos locais (não commitar no Git)
.env
*.env
*.env.local
.memory/.env
.memory/*.env
.memory/*.local
.memory/*.env.local

# IDEs e editores
.vscode/
.idea/
*.swp
*.swo
.DS_Store
__pycache__/
*.pyc

# Node.js — viewer Electron (ADR-048): node_modules não versionado;
# package.json + package-lock.json VERSIONADOS (são as deps do viewer Electron).
node_modules/

# Build artifacts — viewer (Vite output) + electron (tsc output).
# Recompile via `npm run build` quando precisar.
viewer/dist/
electron/dist/

# Artefatos de smoke test / Playwright CLI (output de validação visual)
screenshot-*.png
smoke-*.html
config-global.txt
config-local.txt
debug-*.cjs
test-*.cjs
