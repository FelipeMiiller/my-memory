# Binários e executáveis Go
bin/
dist/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Bancos de dados SQLite locais
*.db
*.db-journal
*.db-wal
*.db-shm
.memory/*.db
.memory/*.db-*

# Dados de teste e vaults locais
data/
vault_test/

# Arquivos de ambiente e segredos locais (não commitar no Git)
.env
*.env
*.env.local
.memory/.env
.memory/*.env
.memory/*.local
.memory/*.env.local

# IDEs e editores
.vscode/
.idea/
*.swp
*.swo
.DS_Store
__pycache__/
*.pyc

# Node.js — a toolchain da viewer vive em `viewer/` (ADR-059 e ADR-060).
# `viewer/` é fonte versionada; `node_modules/` e `dist/` nunca entram.
node_modules/

# Build artifacts genéricos — Vite / tsc (viewer).
out/
dist/
.vite/
**/out/**
**/dist/**

# Raiz servida pelo transporte HTTP do MCP (ADR-059 D-2): o build da viewer
# copiado para `app/` e os artefatos de grafo gerados em `graph/`. É gerada em
# tempo de execução, vive fora do escopo de indexação do vault e nunca é
# versionada.
.mymemory/

# Artefatos de smoke test / Playwright CLI (output de validação visual)
screenshot-*.png
smoke-*.html
config-global.txt
config-local.txt
debug-*.cjs
test-*.cjs
test-results/

# Git worktrees locais (contêm repositórios git aninhados — nunca commitar)
.worktrees/
