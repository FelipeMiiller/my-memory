.memory/*.local
.memory/*.env.local

# IDEs e editores
.vscode/
.idea/
*.swp
*.swo
.DS_Store
__pycache__/
*.pyc

# Node.js — viewer Electron removido (2026-10-18). Os ignores abaixo são
# mantidos apenas como barreira defensiva contra artefatos locais remanescentes.
node_modules/

# Build artifacts genéricos — Electron Forge / Vite / tsc (viewer removido).
out/
dist/
.vite/
**/out/**
**/dist/**

# Artefatos de smoke test / Playwright CLI (output de validação visual)
screenshot-*.png
smoke-*.html
config-global.txt
config-local.txt
debug-*.cjs
test-*.cjs
test-results/

# Git worktrees locais (contêm repositórios git aninhados — nunca commitar)
.worktrees/
