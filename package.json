{
  "name": "my-memory-workspace",
  "version": "1.4.0",
  "private": true,
  "description": "Monorepo root for my-memory: Go CLI + Electron + Vite + React viewer",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p electron/tsconfig.json && tsc -p electron/tsconfig.node.json && npm run viewer:build",
    "typecheck": "tsc --noEmit -p electron/tsconfig.json && tsc --noEmit -p viewer/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "echo \"lint placeholder — add eslint in Phase 2\" && exit 0",
    "smoke": "node scripts/electron-smoke.test.mjs",
    "viewer:dev": "vite --config viewer/vite.config.ts --configDir viewer",
    "viewer:build": "cd viewer && vite build",
    "electron:dev": "electron .",
    "electron:build": "tsc -p electron/tsconfig.json && tsc -p electron/tsconfig.node.json"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cytoscape": "^3.30.0",
    "i18next": "23.16.8",
    "lucide-react": "^0.451.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "15.7.4",
    "react-resizable-panels": "^2.1.4",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/cytoscape": "^3.21.7",
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "electron": "^30.0.0",
    "electron-vite": "^2.3.0",
    "jsdom": "^25.0.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
