{
  "name": "my-memory",
  "productName": "Grafo de Memória",
  "version": "2.0.0",
  "private": true,
  "description": "My-Memory Viewer — Electron + Vite + React 19 + shadcn/ui (LuanRoger/electron-shadcn template)",
  "license": "MIT",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "smoke": "electron-forge package && playwright test src/tests/e2e/example.test.ts --reporter=line",
    "build": "electron-forge package"
  },
  "overrides": {
    "@electron-forge/plugin-fuses": {
      "@electron/fuses": "^2"
    }
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.59",
    "@ai-sdk/openai": "^4.0.72",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "ai": "^7.0.109",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "cytoscape": "^3.30.0",
    "electron-squirrel-startup": "^1.0.1",
    "i18next": "^26.4.2",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^0.451.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-resizable-panels": "^2.1.4",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.7.0",
    "update-electron-app": "^3.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/publisher-github": "^7.11.2",
    "@electron-forge/shared-types": "^7.11.2",
    "@electron/fuses": "^2.1.3",
    "@playwright/test": "^1.63.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/cytoscape": "^3.21.7",
    "@types/node": "^22.7.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "^44.4.3",
    "electron-devtools-installer": "^4.0.0",
    "electron-playwright-helpers": "^3.1.2",
    "jsdom": "^30.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
